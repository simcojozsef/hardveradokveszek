APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug


#DB DEV
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=


SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=postmark
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@gigapiac.hu"
MAIL_FROM_NAME="GigaPiac"
POSTMARK_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://gigapiac.hu/auth/google/callback

# ---- Stripe ----
# Local/dev: keep the test keys. Never put a live secret in a repo.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_API_VERSION=2026-09-30.endive

# ---- Szamlazz.hu (Szamla Agent) ----
SZAMLAZZ_AGENT_KEY=
SZAMLAZZ_ENABLED=false
SZAMLAZZ_USE_TEST=false
SZAMLAZZ_USER=
SZAMLAZZ_PASSWORD=
SZAMLAZZ_VAT_RATE=27

# Issuer (own company) details. Required on every document; finalise the
# tax treatment with the accountant before enabling live billing.
SZAMLAZZ_SELLER_NAME=
SZAMLAZZ_SELLER_TAX_NUMBER=
SZAMLAZZ_SELLER_COUNTRY=HU
SZAMLAZZ_SELLER_POSTAL_CODE=
SZAMLAZZ_SELLER_CITY=
SZAMLAZZ_SELLER_ADDRESS=
SZAMLAZZ_SELLER_EMAIL=
SZAMLAZZ_SELLER_BANK_ACCOUNT=
# The apex domain. Store subdomains are <slug>.<APP_DOMAIN>.
APP_DOMAIN=gigapiac.hu
# Apex domain exposed to the SPA, for showing the store subdomain URL.
VITE_APP_DOMAIN=gigapiac.hu
# One-off pre-reservation credits. Leave the price empty to keep it unsold.
STRIPE_BUMP_PRICE_ID=
STRIPE_BUMP_PURCHASE_ENABLED=false

# Accounts that skip the emailed 2FA code (comma-separated). Keep it minimal.
TWO_FACTOR_EXEMPT_EMAILS=

# Expected gross PRO price in forint; a sanity guard on issued invoices.
SZAMLAZZ_EXPECTED_GROSS_HUF=4990
